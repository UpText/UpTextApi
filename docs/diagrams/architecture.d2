direction: down

vars: {
  d2-config: {
    pad: 20
  }
}

app: App {
  shape: rectangle
  style.fill: "#EAF5FF"
  style.stroke: "#1670A5"
}

api: "UpTextApi\nREST API" {
  style.fill: "#E6FAFC"
  style.stroke: "#0891B2"
}

sql: SQL Server {
  grid-rows: 1
  style.fill: "#FFF7E6"
  style.stroke: "#D69520"

  procedures: Stored procedures {
    shape: rectangle
    tooltip: Stored and executed inside SQL Server
  }

  tables: Tables / data {
    shape: cylinder
  }

  procedures <-> tables: Read / write
}

app <-> api: "HTTP / JSON"
api <-> sql.procedures: "SQL: parameters / results"
